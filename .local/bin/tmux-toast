#!/usr/bin/env bash
# ==============================================================================
# tmux-toast — Sleek self-dismissing floating notification popup for tmux
# Disappears automatically after ~1s (or immediately on any keypress)
# Works both in normal panes and inside the nested `scratch` (C-h j) popup!
# ==============================================================================

MSG="${1:-Copied to Mac clipboard}"
SUB="${2:-Ready to Cmd+V}"
COLOR="${3:-#a6e3a1}"

if [ -z "$TMUX" ]; then
  exit 0
fi

# Find the active client where the user is currently typing/selecting.
# If the `scratch` session is currently attached (inside C-h j), target the
# `scratch` client so the toast renders INSIDE the scratchpad without closing C-h j!
TARGET_CLIENT=$(tmux list-clients -t scratch -F '#{client_name}' 2>/dev/null | head -n 1)
if [ -z "$TARGET_CLIENT" ]; then
  TARGET_CLIENT=$(tmux display-message -p '#{client_name}' 2>/dev/null)
fi
if [ -z "$TARGET_CLIENT" ]; then
  TARGET_CLIENT=$(tmux list-clients -F '#{client_name}' 2>/dev/null | head -n 1)
fi

(
  # Small delay if launched from inside an exiting popup (like C-h c)
  if [ "${4:-0}" = "delay" ]; then
    sleep 0.08
  fi

  tmux display-popup -c "$TARGET_CLIENT" -E -b rounded -s "fg=#cdd6f4,bg=#1e1e2e" -S "fg=${COLOR},bold" -w 42 -h 4 \
    "bash -c 'printf \"\n  \033[1;32m✔\033[0m  \033[1;37m%s\033[0m\n     \033[0;90m%s\033[0m\" \"$MSG\" \"$SUB\"; read -r -s -n 1 -t 1 || true'" \
    2>/dev/null
) >/dev/null 2>&1 &
disown
